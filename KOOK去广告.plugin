#!name=KOOK_NoAds
#!desc=KOOK去广告（启动广告）
#!author=KIKU
#!version=1.0

[MITM]
hostname = %APPEND% material.adwangmai.com,*.fancyapi.com

[Rule]
DOMAIN,material.adwangmai.com,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT

[Rewrite]
# 启动页广告
^https?:\/\/.*adwangmai\.com\/.* REJECT-DICT
^https?:\/\/(g|t2|pic|lftxali)\.fancyapi\.com\/.* REJECT-DICT
^https?:\/\/.*\/(ad|advert|splash)[\/\?].* REJECT-DICT

# 推荐广告


# 信息流广告
